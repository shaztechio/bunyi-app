_arguments -C \
  '--json[write one JSON result]' \
  '--jsonl[write JSON-lines progress and a terminal result]' \
  '--one-shot[bypass a running server]' \
  '--require-server[require a running server]' \
  '--help[show help]' \
  '1:command:(generate models speakers transcribe play voices history doctor backup config logs server jobs version)' \
  '*:argument:->args'

case "$words[2]" in
  generate) _values 'mode' preset design clone ;;
  models) _values 'command' list status download verify remove ;;
  voices) _values 'command' list add remove ;;
  history) _values 'command' list show remove ;;
  backup) _values 'command' create restore ;;
  config) _values 'command' list get set ;;
  logs) _values 'command' path tail clear ;;
  server) _values 'command' run start status preload unload stop ;;
  jobs) _values 'command' status follow cancel ;;
esac

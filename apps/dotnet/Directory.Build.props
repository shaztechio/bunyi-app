<Project>

  <!--
    Settings shared by every project here, so a new one inherits them rather
    than repeating them. Versions live in Directory.Packages.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- A warning we let through is one nobody reads. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Same input, same output: needed for any later signing or provenance. -->
    <Deterministic>true</Deterministic>

    <!--
      The app version. macOS keeps its own in apps/macos/project.yml; the two
      are released separately and are not expected to march in step.
    -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Company>Bunyi contributors</Company>
    <Product>Bunyi</Product>
    <Authors>Shazron Abdullah and Bunyi contributors</Authors>
    <Copyright>Copyright 2026 Shazron Abdullah and Bunyi contributors</Copyright>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine, model management, download, backup, voices, transcription.
    UI-framework-free by rule: no Avalonia reference belongs here, and CI
    checks for one. See ../../AGENTS.md.
  -->
  <PropertyGroup>
    <RootNamespace>Bunyi.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      So the tests can reach internals worth asserting without widening the
      public API for them. Doctor's source probe is the case in point: how the
      URL is built is a real defect risk — a hardcoded config.json would report
      the preset-voice export's server as dead — but it is not something a
      caller should be able to reach into.
    -->
    <InternalsVisibleTo Include="Bunyi.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Preset-voice inference. This brings ONNX Runtime with it, and NAudio,
      whose Windows-only assemblies are inert on Linux — verified, see
      ../../RESEARCH-ONNX.md. Its downloader is deliberately unused: it
      implements none of spec §3b.
    -->
    <PackageReference Include="ElBruno.QwenTTS" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />

    <!--
      Playback, through miniaudio: identical on Windows and Linux, and the
      package carries native libraries for both. System.Media and NAudio's
      output backends are Windows-only, which apps/dotnet/AGENTS.md rules out.
      Not a UI dependency — playing a file is not drawing one.
    -->
    <PackageReference Include="SoundFlow" />
  </ItemGroup>

</Project>

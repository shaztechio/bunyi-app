<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine, model management, download, backup, voices, transcription.
    UI-framework-free by rule: no Avalonia reference belongs here, and CI
    checks for one. See ../../AGENTS.md.
  -->
  <PropertyGroup>
    <RootNamespace>Bunyi.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      So the tests can reach internals worth asserting without widening the
      public API for them. Doctor's source probe is the case in point: how the
      URL is built is a real defect risk — a hardcoded config.json would report
      the preset-voice export's server as dead — but it is not something a
      caller should be able to reach into.
    -->
    <InternalsVisibleTo Include="Bunyi.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Two flavours of the same runtime, chosen by `-p:BunyiCuda=true` at publish
      time and by nothing at all otherwise.

      The GPU package is not the default and will not become one. It adds
      128.6 MB to the download (90.4 MB to 219.0 MB zipped, measured on
      win-x64), almost all of it onnxruntime_providers_cuda.dll — and that file
      links against cuBLAS and cudart, which ONNX Runtime does not ship. So a
      user without NVIDIA's CUDA Toolkit installed would pay 2.4x for a
      provider that cannot load. The separate artifact goes to the people who
      already have the toolkit; everyone else downloads what they can use.
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime"
                      Condition="'$(BunyiCuda)' != 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu"
                      Condition="'$(BunyiCuda)' == 'true'" />

    <!--
      Playback, through miniaudio: identical on Windows and Linux, and the
      package carries native libraries for both. System.Media and NAudio's
      output backends are Windows-only, which apps/dotnet/AGENTS.md rules out.
      Not a UI dependency — playing a file is not drawing one.
    -->
    <PackageReference Include="SoundFlow" />
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
  </ItemGroup>

</Project>

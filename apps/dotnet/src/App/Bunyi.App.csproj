<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- What Explorer, the taskbar and the shortcut show. -->
    <ApplicationIcon>Assets/bunyi.ico</ApplicationIcon>

    <OutputType>WinExe</OutputType>
    <RootNamespace>Bunyi.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Both are shipped as portable self-contained builds. -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>

    <!--
      Pre-compile IL to native at publish time, so the first call to a method
      does not wait for the JIT. A cold start runs almost everything for the
      first time, which is why this is worth its size here and would not be in
      a long-running process.

      Measured with the §8 startup line, not assumed. Two builds of one
      commit, published self-contained, run on the same machine as each other:

                    Linux              Windows
        runtime    40 →  40 ms      32 →  27 ms
        platform  301 → 324 ms     319 → 239 ms
        theme     225 →  46 ms      86 →  42 ms
        app       390 → 267 ms     372 → 185 ms
        show      294 → 139 ms     194 →  85 ms
        frame     304 → 264 ms     186 → 119 ms
        total    1554 → 1080 ms   1189 → 698 ms
                      -30%              -41%

      The columns are two different machines and are not a comparison of the
      platforms — only each column against itself is a measurement. The
      Windows figures are the mean of three runs, which agreed to within 80 ms.

      `runtime` is the only phase this cannot help: it is over before Main, so
      no amount of precompiled IL is in it yet. Everything else moves, because
      everything else is managed code being run for the first time —
      including `platform`, which is Avalonia bringing up windowing and
      rendering. That phase is a quarter faster on Windows and flat on Linux,
      where more of it is genuinely native: X11, GL and DBus round trips, and
      the font manager.

      `theme` is the surprise: named for parsing the Fluent theme and this
      app's dictionaries, and almost entirely JIT. The parsing was never the
      cost. `show` moving is the other one — Window.Show runs a great deal
      of Avalonia for the first time.

      Set here rather than on the publish command lines so that CI, the release
      workflow and the commands in AGENTS.md all produce the same binary. It is
      a publish-time property: `dotnet build` and `dotnet run` ignore it, so
      the inner loop is not slowed by crossgen2.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Bunyi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      HELP.md is the only copy of the help text, and it ships inside the
      assembly so a self-contained build has nothing to lose on the way out.
      Named Bunyi.App.HELP.md by the default resource naming.
    -->
    <!--
      The icon, shared with the macOS app so the two look like one product.
      Built from its asset catalogue by tools/make-icons.py and committed —
      see that file for why the sizes are what they are.
    -->
    <AvaloniaResource Include="Assets/bunyi.png" />

    <EmbeddedResource Include="..\..\HELP.md" Link="HELP.md" />

    <!--
      The credits are shared with the macOS app: one list, so the two cannot
      disagree about what the project is built on. It lives in /spec because
      that is where this repository keeps what both apps must agree on — they
      share no code, and this is data.
    -->
    <EmbeddedResource Include="..\..\..\..\spec\CREDITS.json" Link="CREDITS.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The view is the unit under test for the dialogs it builds in code. -->
    <InternalsVisibleTo Include="Bunyi.App.Tests" />
  </ItemGroup>

</Project>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bunyi.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Shared with the headless tests, so both load the same colours. -->
        <ResourceInclude Source="avares://Bunyi.App/Themes/Brand.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- Shared by every window the app opens, dialogs included. -->
    <StyleInclude Source="avares://Bunyi.App/Themes/Controls.axaml" />
  </Application.Styles>
</Application>

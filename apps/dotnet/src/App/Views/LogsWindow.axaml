<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bunyi.App.ViewModels"
        xmlns:diag="clr-namespace:Bunyi.Core.Diagnostics;assembly=Bunyi.Core"
        x:Class="Bunyi.App.Views.LogsWindow"
        x:DataType="vm:LogsViewModel"
        Width="760" Height="520" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Title="Logs"
        Icon="/Assets/bunyi.png">

  <DockPanel Margin="16">

    <!--
      §8: Copy and Clear. The row sits at the bottom so the log itself gets
      every pixel above it, and so Clear is nowhere near where the eye lands
      when reading.
    -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                 Text="{Binding Lines.Count, StringFormat='{}{0} lines'}" />
      <Button Grid.Column="1" Name="CopyButton" Content="Copy" MinWidth="90"
              Click="OnCopyClicked"
              ToolTip.Tip="Copy the whole log" />
      <Button Grid.Column="2" Name="ClearButton" Content="Clear" MinWidth="90" Margin="8,0,0,0"
              Command="{Binding ClearCommand}"
              ToolTip.Tip="Empty the log" />
    </Grid>

    <Border Background="{DynamicResource BunyiSurface}"
            CornerRadius="{DynamicResource BunyiControlRadius}"
            Padding="2">
      <Panel>
        <!--
          §8: timestamped, selectable, monospaced. One block for the whole log
          rather than one control per line: a selection cannot cross from one
          control into the next, so a control per line meant dragging down the
          log selected nothing past the line it started in — and copying a run
          of lines is the ordinary reason to select any of it. Copy still takes
          the whole log in one go.

          Disabled rather than Auto: it is what holds the text to the width of
          the window, and so what makes the wrapping below happen at all. With
          Auto the text is measured against infinite width, every line takes as
          much as it wants, and nothing ever wraps.
        -->
        <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled">
          <!--
            Wrapped, because a log is read by scanning down it. A long line — a
            path, an exception, a model id — used to put its own right-hand end
            off-screen, and that end is where the detail of an error is.

            The text is set from the code-behind rather than bound, so that an
            arriving line cannot clear a selection someone is in the middle of.
          -->
          <SelectableTextBlock Name="LogText"
                               Margin="10,8"
                               FontFamily="{DynamicResource BunyiMono}"
                               FontSize="12"
                               TextWrapping="Wrap" />
        </ScrollViewer>

        <!--
          An empty log is normal on a fresh launch, so it says so rather than
          looking like a window that failed to load.
        -->
        <TextBlock Text="Nothing logged yet."
                   Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding IsEmpty}" />
      </Panel>
    </Border>

  </DockPanel>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Bunyi.App.ViewModels"
             x:Class="Bunyi.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">


  <Panel>
    <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Opacity="0.7" TextWrapping="Wrap" MaxWidth="360"
               TextAlignment="Center" />

    <!--
      AllowAutoHide is off so the scrollbar takes part in the layout instead of
      floating over it. Overlaid, it sat on top of the Trash button at the end
      of every row — the button was still there and still clickable, which is
      the worst version of this: it looked broken without being broken.
    -->
    <!--
      Named, because the code-behind gives it the keys Avalonia does not: Home,
      End and the arrows. Page Up/Down and Tab already reach it — see
      HistoryView.axaml.cs for what was measured.
    -->
    <ScrollViewer x:Name="List"
                  IsVisible="{Binding !IsEmpty}"
                  AllowAutoHide="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryRow">
            <Border BorderThickness="0,0,0,1" Padding="4,10"
                    BorderBrush="{DynamicResource BunyiCardBorder}"
                    ToolTip.Tip="{Binding Details}">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                <!--
                  §2a: progress is drawn as a ring around the play button
                  itself rather than a separate bar — the control and its
                  progress are the same object, which is what the row has space
                  for. Play/stop only; there is deliberately no pause.
                -->
                <Panel Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0">
                  <Path Data="{Binding PlayProgress, Converter={x:Static vm:ProgressRing.Instance}}"
                        Stroke="{DynamicResource BunyiAccent}" StrokeThickness="2.5"
                        StrokeLineCap="Round" IsVisible="{Binding IsPlaying}"
                        Width="34" Height="34"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <!--
                    Circular and centred inside the ring: §2a wants the control
                    and its progress to be one object, and a rounded square
                    sitting inside a circle reads as two.
                  -->
                  <Button Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).TogglePlayCommand}"
                          CommandParameter="{Binding}"
                          Width="28" Height="28" Padding="0"
                          CornerRadius="{DynamicResource BunyiPillRadius}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          ToolTip.Tip="Play or stop this clip">
                    <Panel>
                      <!--
                        Stretch="None": the geometry is already drawn at 28px
                        with its centre of area on the button's centre, so any
                        scaling or alignment would move it back off.
                      -->
                      <Path Data="{DynamicResource IconPlayRound28}"
                            Fill="{Binding $parent[Button].Foreground}"
                            Stroke="{x:Null}" Stretch="None"
                            Width="28" Height="28"
                            IsVisible="{Binding !IsPlaying}" />
                      <Path Data="{DynamicResource IconStopRound28}"
                            Fill="{Binding $parent[Button].Foreground}"
                            Stroke="{x:Null}" Stretch="None"
                            Width="28" Height="28"
                            IsVisible="{Binding IsPlaying}" />
                    </Panel>
                  </Button>
                </Panel>

                <!--
                  Grids rather than horizontal StackPanels. A StackPanel offers
                  its children infinite width, so TextTrimming never fires and a
                  long line runs under the buttons on the right instead of
                  ending in an ellipsis. Clone rows made this obvious: their
                  subtitle carries the whole reference transcript.
                -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <!--
                      One colour per mode, not the accent. The accent is the
                      progress ring on the row that is playing, so a pill in the
                      same purple competed with the only colour in this view
                      that carries state - and all three modes wore it, so it
                      said nothing about which mode a row was either. Colours
                      and the faint fill are ported from the macOS app; see
                      ModeTint.
                    -->
                    <Border Grid.Column="0"
                            Background="{Binding Mode, Converter={x:Static vm:ModeTint.Instance}, ConverterParameter=faint}"
                            CornerRadius="{DynamicResource BunyiPillRadius}"
                            Padding="6,1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Mode}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{Binding Mode, Converter={x:Static vm:ModeTint.Instance}}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Summary}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                  <Button Classes="icon"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).DownloadCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Save a copy somewhere else">
                    <Path Data="{DynamicResource IconSave}" />
                  </Button>

                  <!--
                    The copy button still acknowledges the copy (§2a) — it turns
                    into a tick for a moment. An icon that does nothing visible
                    gets pressed again, which is the whole reason the
                    acknowledgement exists.
                  -->
                  <Button Classes="icon"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).CopyDetailsCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Copy everything about this clip">
                    <Panel>
                      <Path Data="{DynamicResource IconCopy}" IsVisible="{Binding !Copied}" />
                      <Path Data="{DynamicResource IconTick}" IsVisible="{Binding Copied}"
                            Stroke="{DynamicResource BunyiAccent}" />
                    </Panel>
                  </Button>

                  <Button Classes="icon"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).RevealCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Show this file on disk">
                    <Path Data="{DynamicResource IconFolder}" />
                  </Button>
                  <Button Classes="icon"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).TrashCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Move this clip to the Trash">
                    <Path Data="{DynamicResource IconTrash}" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Panel>
</UserControl>

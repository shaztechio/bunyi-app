<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Bunyi.App.ViewModels"
             x:Class="Bunyi.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <UserControl.Styles>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="{DynamicResource BunyiIconButtonSize}" />
      <Setter Property="Height" Value="{DynamicResource BunyiIconButtonSize}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource BunyiPillRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon > Path">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Opacity="0.7" TextWrapping="Wrap" MaxWidth="360"
               TextAlignment="Center" />

    <ScrollViewer IsVisible="{Binding !IsEmpty}">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryRow">
            <Border BorderThickness="0,0,0,1" Padding="4,10"
                    BorderBrush="{DynamicResource BunyiCardBorder}"
                    ToolTip.Tip="{Binding Details}">
              <Grid ColumnDefinitions="Auto,*,Auto">

                <!--
                  §2a: progress is drawn as a ring around the play button
                  itself rather than a separate bar — the control and its
                  progress are the same object, which is what the row has space
                  for. Play/stop only; there is deliberately no pause.
                -->
                <Panel Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0">
                  <Path Data="{Binding PlayProgress, Converter={x:Static vm:ProgressRing.Instance}}"
                        Stroke="{DynamicResource BunyiAccent}" StrokeThickness="2.5"
                        StrokeLineCap="Round" IsVisible="{Binding IsPlaying}"
                        Width="34" Height="34"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <!--
                    Circular and centred inside the ring: §2a wants the control
                    and its progress to be one object, and a rounded square
                    sitting inside a circle reads as two.
                  -->
                  <Button Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).TogglePlayCommand}"
                          CommandParameter="{Binding}"
                          Width="28" Height="28" Padding="0"
                          CornerRadius="{DynamicResource BunyiPillRadius}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          ToolTip.Tip="Play or stop this clip">
                    <Panel>
                      <!-- Nudged right by a hair: a triangle's visual centre is
                           left of its bounding box. -->
                      <Path Data="{DynamicResource IconPlay}"
                            Fill="{Binding $parent[Button].Foreground}"
                            Width="15" Height="15" Stretch="Uniform" Margin="2,0,0,0"
                            IsVisible="{Binding !IsPlaying}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Path Data="{DynamicResource IconStop}"
                            Fill="{Binding $parent[Button].Foreground}"
                            Width="13" Height="13" Stretch="Uniform"
                            IsVisible="{Binding IsPlaying}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                  </Button>
                </Panel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Background="{DynamicResource BunyiAccent}" CornerRadius="{DynamicResource BunyiPillRadius}"
                            Padding="6,1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Mode}" FontSize="10" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                  <Button Classes="icon"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).DownloadCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Save a copy somewhere else">
                    <Path Data="{DynamicResource IconSave}" />
                  </Button>

                  <!--
                    The copy button still acknowledges the copy (§2a) — it turns
                    into a tick for a moment. An icon that does nothing visible
                    gets pressed again, which is the whole reason the
                    acknowledgement exists.
                  -->
                  <Button Classes="icon"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).CopyDetailsCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Copy everything about this clip">
                    <Panel>
                      <Path Data="{DynamicResource IconCopy}" IsVisible="{Binding !Copied}" />
                      <Path Data="{DynamicResource IconTick}" IsVisible="{Binding Copied}"
                            Stroke="{DynamicResource BunyiAccent}" />
                    </Panel>
                  </Button>

                  <Button Classes="icon"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).RevealCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Show this file on disk">
                    <Path Data="{DynamicResource IconFolder}" />
                  </Button>
                  <Button Classes="icon"
                          Command="{Binding $parent[ItemsControl].((vm:HistoryViewModel)DataContext).TrashCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Move this clip to the Trash">
                    <Path Data="{DynamicResource IconTrash}" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Panel>
</UserControl>

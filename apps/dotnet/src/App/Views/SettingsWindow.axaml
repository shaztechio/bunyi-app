<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bunyi.App.ViewModels"
        xmlns:core="clr-namespace:Bunyi.Core.Settings;assembly=Bunyi.Core"
        x:Class="Bunyi.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="640" Height="560" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Title="Settings">

  <Window.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource BunyiAccent}" />
    </Style>
    <!-- Long explanatory prose sits beside the controls it explains, behind a
         left rule, rather than at the top like a README. -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="{DynamicResource BunyiControlRadius}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="{DynamicResource BunyiControlRadius}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="{DynamicResource BunyiControlRadius}" />
    </Style>
    <Style Selector="Border.callout">
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BunyiAccent}" />
      <Setter Property="Padding" Value="10,2,0,2" />
    </Style>
  </Window.Styles>

  <TabControl Margin="12" SelectionChanged="OnTabChanged">

    <TabItem Header="General">
      <StackPanel Margin="12" Spacing="12">
        <TextBlock Text="APPEARANCE" Classes="eyebrow" />
        <ComboBox ItemsSource="{Binding Appearances}" SelectedItem="{Binding Appearance}"
                  MinWidth="200" />
        <Border Classes="callout">
          <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                     Text="System follows your computer. Light and Dark keep Bunyi that way whatever your computer does. The change applies straight away, to every Bunyi window." />
        </Border>
      </StackPanel>
    </TabItem>

    <TabItem Header="Models">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="12">
          <TextBlock Text="WHERE EACH MODE GETS ITS MODEL" Classes="eyebrow" />
          <Border Classes="callout">
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       Text="Either a Hugging Face repository name, or a web address starting with https:// if you host the files yourself. Bunyi decides which you meant from what you type. Clear a box to go back to the built-in default for that mode." />
          </Border>

          <StackPanel Spacing="4">
            <TextBlock Text="Preset voice" FontSize="12" Opacity="0.75" />
            <TextBox Text="{Binding PresetVoiceSource}" PlaceholderText="Built-in default" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Voice design" FontSize="12" Opacity="0.75" />
            <TextBox Text="{Binding VoiceDesignSource}" PlaceholderText="Built-in default" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Voice clone" FontSize="12" Opacity="0.75" />
            <TextBox Text="{Binding VoiceCloneSource}" PlaceholderText="Built-in default" />
          </StackPanel>

          <Button Content="Reset all three to their defaults" Command="{Binding ResetSourcesCommand}" />

          <Separator />

          <TextBlock Text="SAVED CONFIGURATIONS" Classes="eyebrow" />
          <Border Classes="callout">
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       Text="The three go together: switching between Hugging Face and your own server means changing all of them. Save the set under a name and switch between them in one click." />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding NewConfigName}" PlaceholderText="Name this set" MinWidth="220" />
            <Button Content="Save" Command="{Binding SaveConfigCommand}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Configs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:ModelConfig">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="Use" FontSize="11" Margin="0,0,4,0"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UseConfigCommand}"
                          CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Content="Delete" FontSize="11"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteConfigCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Storage">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="12">
          <TextBlock Text="WHERE MODELS ARE KEPT" Classes="eyebrow" />
          <SelectableTextBlock Text="{Binding ModelsFolder}" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Choose a folder" Command="{Binding ChooseFolderCommand}" />
            <Button Content="Show in the file manager" Command="{Binding ShowFolderCommand}" />
            <Button Content="Use the default" Command="{Binding ResetFolderCommand}"
                    IsEnabled="{Binding IsCustomModelsFolder}" />
          </StackPanel>
          <Border Classes="callout">
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       Text="Models are large, so you can keep them anywhere — an external drive, for instance. A slow drive makes generating slower too, not just downloading, because the model is read while it runs." />
          </Border>

          <Separator />

          <TextBlock Text="DOWNLOADED MODELS" Classes="eyebrow" />
          <TextBlock Text="{Binding StorageSummary}" FontSize="12" Opacity="0.75" />
          <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DownloadedModelRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11" Opacity="0.7">
                      <Run Text="{Binding SizeText}" /><Run Text=" · " /><Run Text="{Binding OriginText}" />
                    </TextBlock>
                  </StackPanel>
                  <Button Grid.Column="1" Content="Delete" FontSize="11"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteModelCommand}"
                          CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator />

          <TextBlock Text="DOWNLOAD IN ADVANCE" Classes="eyebrow" />
          <Border Classes="callout">
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       Text="If you would rather fetch a model before you need it, copy one of these and run it." />
          </Border>
          <ItemsControl ItemsSource="{Binding PreDownloadCommands}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <SelectableTextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace"
                                     FontSize="11" TextWrapping="Wrap" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Backup">
      <StackPanel Margin="12" Spacing="12">
        <TextBlock Text="BACK UP AND RESTORE" Classes="eyebrow" />
        <Border Classes="callout">
          <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                     Text="Not built yet. It will collect your models folder into a single .zip, so you do not have to download several gigabytes again after moving to a new machine." />
        </Border>
      </StackPanel>
    </TabItem>
  </TabControl>
</Window>

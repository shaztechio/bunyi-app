<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bunyi.App.ViewModels"
        xmlns:inf="clr-namespace:Bunyi.App.Infrastructure"
        xmlns:core="clr-namespace:Bunyi.Core.Settings;assembly=Bunyi.Core"
        x:Class="Bunyi.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="640" Height="560" MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Title="Settings"
        Icon="/Assets/bunyi.png">

  <Window.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource BunyiAccent}" />
    </Style>
    <!-- Long explanatory prose sits beside the controls it explains, behind a
         left rule, rather than at the top like a README. -->
    <Style Selector="Border.callout">
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BunyiAccent}" />
      <Setter Property="Padding" Value="10,2,0,2" />
    </Style>
  </Window.Styles>

  <TabControl Margin="12" SelectionChanged="OnTabChanged">

    <TabItem Header="General">
      <StackPanel Margin="12" Spacing="12">
        <TextBlock Name="AppearanceLabel" Text="APPEARANCE" Classes="eyebrow" />
        <!--
          Named and announced the way the main window's pickers are — see the
          comment on the Language box in MainWindow.axaml for why a ComboBox
          needs ItemStatus to announce a change at all.
        -->
        <ComboBox ItemsSource="{Binding Appearances}" SelectedItem="{Binding Appearance}"
                  AutomationProperties.LabeledBy="{Binding #AppearanceLabel}"
                  AutomationProperties.ItemStatus="{Binding Appearance}"
                  MinWidth="200" />
        <Border Classes="callout">
          <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                     Text="System follows your computer. Light and Dark keep Bunyi that way whatever your computer does. The change applies straight away, to every Bunyi window." />
        </Border>

        <!-- §3e. On by default; the callout says what turning it off costs. -->
        <TextBlock Text="MEMORY" Classes="eyebrow" Margin="0,8,0,0" />
        <CheckBox IsChecked="{Binding UnloadOnModeSwitch}"
                  Content="Free memory when switching modes" />
        <Border Classes="callout">
          <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                     Text="Each mode uses its own model, and a model can be several gigabytes. Leave this on and Bunyi lets go of a mode&apos;s model as soon as you leave it. Turn it off to keep it loaded, so coming back to that mode starts straight away — at the cost of the memory it holds meanwhile." />
        </Border>
      </StackPanel>
    </TabItem>

    <TabItem Header="Models">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="12">
          <TextBlock Text="WHERE EACH MODE GETS ITS MODEL" Classes="eyebrow" />
          <Border Classes="callout">
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       Text="Either a Hugging Face repository name, or a web address starting with https:// if you host the files yourself. Bunyi decides which you meant from what you type. Clear a box to go back to the built-in default for that mode." />
          </Border>

          <StackPanel Spacing="4">
            <TextBlock Text="Preset voice" FontSize="12" Opacity="0.75" />
            <TextBox Text="{Binding PresetVoiceSource}" PlaceholderText="{Binding PresetVoiceDefault}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Voice design" FontSize="12" Opacity="0.75" />
            <TextBox Text="{Binding VoiceDesignSource}" PlaceholderText="{Binding VoiceDesignDefault}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Voice clone" FontSize="12" Opacity="0.75" />
            <TextBox Text="{Binding VoiceCloneSource}" PlaceholderText="{Binding VoiceCloneDefault}" />
          </StackPanel>

          <Button Content="Reset all three to their defaults" Command="{Binding ResetSourcesCommand}" />

          <Separator />

          <TextBlock Text="SAVED CONFIGURATIONS" Classes="eyebrow" />
          <Border Classes="callout">
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       Text="The three go together: switching between Hugging Face and your own server means changing all of them. Save the set under a name and switch between them in one click." />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding NewConfigName}" PlaceholderText="Name this set" MinWidth="220" />
            <Button Content="Save" Command="{Binding SaveConfigCommand}" />
          </StackPanel>

          <!--
            The same words macOS shows, because it is the same claim and a user
            comparing the two apps should not have to work out whether they mean
            the same thing. It answers what a person actually wants to know
            before trusting a source the app itself suggests: whose models these
            are, that the bytes are checked, and that the Hub is still where
            they come from.
          -->
          <Border Classes="callout">
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       Text="The Bunyi mirror serves the same Hugging Face models (Apache-2.0) from models.bunyi.app, with checksums the app verifies as it downloads. Useful where Hugging Face is slow or unreachable. Hugging Face stays the default — it is where the models come from." />
          </Border>

          <ItemsControl ItemsSource="{Binding Configs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:ModelConfig">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4">
                  <!--
                    Name and where it points, the way macOS lists these. A name
                    on its own does not say what a configuration contains, and
                    the three values are long URLs that will not fit beside it —
                    the host is the part that answers "which of my sets is
                    this".
                  -->
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.7"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <!--
                    A worded button, not an icon. "Restore" is the spec's own
                    word — §3a has the three sources "saved and restored as a
                    set" — and macOS's. This was a bare tick, which said neither
                    what it did nor to what, and put the safe action and the
                    destructive one at the same weight. Now the safe one is
                    worded and the destructive one is a quiet icon, which is the
                    asymmetry macOS chose deliberately.
                  -->
                  <Button Grid.Column="1" VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RestoreConfigCommand}"
                          CommandParameter="{Binding}"
                          Content="Restore"
                          ToolTip.Tip="Set all three modes to these sources" />
                  <!--
                    No Delete on the built-in: there is nothing on disk to
                    remove, and an action that cannot do what it says is worse
                    than an absent one. Overriding it is a Save under the same
                    name, which the callout above explains.

                    Collapsed rather than disabled — a disabled bin beside one
                    row of a short list reads as something broken, and §12 has
                    already been round this once for Generate.
                  -->
                  <Button Grid.Column="2" Classes="icon"
                          IsVisible="{Binding !IsBuiltIn}"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteConfigCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Delete this configuration">
                    <Path Data="{DynamicResource IconTrash}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Storage">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="12">
          <TextBlock Text="WHERE MODELS ARE KEPT" Classes="eyebrow" />
          <SelectableTextBlock Text="{Binding ModelsFolder}" FontSize="12" TextWrapping="Wrap" />
          <!--
            Words, not icons. These are three different one-off actions rather
            than a repeated row action, and an icon for each would be a guess
            the user has to hover to check.
          -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Choose a folder" Command="{Binding ChooseFolderCommand}" />
            <Button Content="Show in the file manager" Command="{Binding ShowFolderCommand}" />
            <Button Content="Use the default" Command="{Binding ResetFolderCommand}"
                    IsEnabled="{Binding IsCustomModelsFolder}" />
          </StackPanel>
          <Border Classes="callout">
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       Text="Models are large, so you can keep them anywhere — an external drive, for instance. A slow drive makes generating slower too, not just downloading, because the model is read while it runs." />
          </Border>

          <Separator />

          <TextBlock Text="DOWNLOADED MODELS" Classes="eyebrow" />
          <TextBlock Text="{Binding StorageSummary}" FontSize="12" Opacity="0.75" />
          <ItemsControl ItemsSource="{Binding Models}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DownloadedModelRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11" Opacity="0.7">
                      <Run Text="{Binding SizeText}" /><Run Text=" · " /><Run Text="{Binding OriginText}" />
                    </TextBlock>
                  </StackPanel>
                  <!--
                    The same trash button a History row has. Four buttons
                    reading "Delete" down the side of a list is the word
                    repeated, not information; the icon says it once and the
                    tooltip says which.
                  -->
                  <Button Grid.Column="1" Classes="icon"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteModelCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Move this model to the Trash">
                    <Path Data="{DynamicResource IconTrash}" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator />

          <TextBlock Text="DOWNLOAD IN ADVANCE" Classes="eyebrow" />
          <Border Classes="callout">
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       Text="If you would rather fetch a model before you need it, copy one of these and run it." />
          </Border>
          <ItemsControl ItemsSource="{Binding PreDownloadCommands}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <SelectableTextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace"
                                     FontSize="11" TextWrapping="Wrap" Margin="0,3" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Backup">
      <StackPanel Margin="12" Spacing="12">
        <TextBlock Text="BACK UP AND RESTORE" Classes="eyebrow" />

        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                   Text="Collects your models folder into a single .zip, so you do not have to download several gigabytes again on another machine." />

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Back up…" Command="{Binding BackUpCommand}" />
          <Button Content="Restore…" Command="{Binding RestoreCommand}" />
          <Button Content="Stop" Classes="danger"
                  Command="{Binding StopBackupCommand}"
                  IsVisible="{Binding BackupRunning}" />
        </StackPanel>

        <ProgressBar Minimum="0" Maximum="1" Value="{Binding BackupProgress}"
                     IsVisible="{Binding BackupRunning}" Height="4" />

        <TextBlock Text="{Binding BackupDetail}" FontSize="12" Opacity="0.8"
                   TextWrapping="Wrap" IsVisible="{Binding BackupRunning}" />

        <TextBlock Text="{Binding BackupStatus}" FontSize="12" Opacity="0.8"
                   TextWrapping="Wrap" IsVisible="{Binding BackupIsIdle}" />

        <Border Classes="callout">
          <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                     Text="Restoring never replaces a model you already have — anything already here is kept and the backup's copy is skipped." />
        </Border>
      </StackPanel>
    </TabItem>

    <!--
      What an About panel would say. macOS gets one free from AppKit; there is
      no equivalent here and no menu bar to hang one on, so it lives where a
      Windows or Linux user looks for it. Spec §9a.
    -->
    <TabItem Header="About">
      <!-- Scrolls: the credits make this the one tab taller than the window. -->
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="12">
          <TextBlock Text="{x:Static inf:AboutInfo.Name}" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{x:Static inf:AboutInfo.Tagline}" Opacity="0.8" TextWrapping="Wrap" />

          <StackPanel Spacing="4">
            <!--
              Selectable, and with a button beside it. This is the line the tab
              itself asks people to quote in a bug report, so it has to be
              possible to take it away — reading a version off the screen and
              typing it back in is how the wrong one ends up in the report.
            -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <SelectableTextBlock Text="{x:Static inf:AboutInfo.VersionLine}"
                                   VerticalAlignment="Center" />
              <Button Classes="icon" Name="CopyVersionButton"
                      Click="CopyVersion"
                      ToolTip.Tip="Copy the version and platform">
                <Path Data="{DynamicResource IconCopy}" />
              </Button>
            </StackPanel>

            <SelectableTextBlock Text="{x:Static inf:AboutInfo.Licence}" Opacity="0.75" FontSize="12" />
            <SelectableTextBlock Text="{x:Static inf:AboutInfo.Copyright}" Opacity="0.75" FontSize="12"
                                 TextWrapping="Wrap" />
            <Button Classes="link" Content="{x:Static inf:AboutInfo.Home}"
                    FontSize="12" HorizontalAlignment="Left"
                    ToolTip.Tip="Open in your browser"
                    Command="{Binding OpenLinkCommand}"
                    CommandParameter="{x:Static inf:AboutInfo.Home}" />
          </StackPanel>

          <Border Classes="callout">
            <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                       Text="Quote the version and platform above when reporting a problem — the Windows and Linux apps are the same program and look alike." />
          </Border>

          <TextBlock Text="BUILT WITH" Classes="eyebrow" Margin="0,8,0,0" />
          <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                     Text="Bunyi is free software standing on other people's free software." />

          <ItemsControl ItemsSource="{x:Static inf:AboutInfo.Credits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="inf:Credit">
                <StackPanel Margin="0,0,0,10" Spacing="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding Does}" FontSize="12" Opacity="0.8"
                             TextWrapping="Wrap" />
                  <!--
                    A WrapPanel, so a long URL moves to the next line rather
                    than running off the side.
                  -->
                  <WrapPanel>
                    <TextBlock Text="{Binding Licence}" FontSize="11" Opacity="0.6"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Classes="link" Content="{Binding Home}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Open in your browser"
                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).OpenLinkCommand}"
                            CommandParameter="{Binding Home}" />
                  </WrapPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="THE VOICES" Classes="eyebrow" Margin="0,8,0,0" />
          <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8"
                     Text="The models are downloaded rather than shipped, and they are the part that actually speaks." />

          <ItemsControl ItemsSource="{x:Static inf:AboutInfo.ModelCredits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="inf:Credit">
                <StackPanel Margin="0,0,0,10" Spacing="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding Does}" FontSize="12" Opacity="0.8"
                             TextWrapping="Wrap" />
                  <!--
                    A WrapPanel, so a long URL moves to the next line rather
                    than running off the side.
                  -->
                  <WrapPanel>
                    <TextBlock Text="{Binding Licence}" FontSize="11" Opacity="0.6"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Classes="link" Content="{Binding Home}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Open in your browser"
                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).OpenLinkCommand}"
                            CommandParameter="{Binding Home}" />
                  </WrapPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>

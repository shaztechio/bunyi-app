<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bunyi.App.ViewModels"
        xmlns:views="clr-namespace:Bunyi.App.Views"
        x:Class="Bunyi.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="760" Height="680" MinWidth="620" MinHeight="580"
        Title="Bunyi">

  <Window.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource BunyiAccent}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="{DynamicResource BunyiCardRadius}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BunyiCardBorder}" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBlock.rowLabel">
      <Setter Property="Width" Value="76" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
  </Window.Styles>

  <!-- 20 window inset, 16 between cards: the spacing scale from UI-PLAN.md. -->
  <DockPanel Margin="20">

    <!--
      Header. §2 requires Help and the log to be one click from the main window
      and to STAY REACHABLE while work is in progress: a long download is
      exactly when someone wants to read the help or watch the log, and neither
      touches the running job. macOS gets that for free from a window toolbar;
      Avalonia has none, so they live here, outside the disabled scope by
      construction.
    -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="BUNYI" Classes="eyebrow" />
        <TextBlock Text="{Binding ModeSubtitle}" FontSize="12" Opacity="0.75" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="icon" Click="OnSettingsClicked" Name="SettingsButton"
                ToolTip.Tip="Settings — models, storage and appearance">
          <Path Data="{DynamicResource IconSettings}" />
        </Button>
        <Button Classes="icon" Name="LogsButton"
                ToolTip.Tip="Logs — what Bunyi has been doing">
          <Path Data="{DynamicResource IconLogs}" />
        </Button>
        <Button Classes="icon" Name="HelpButton"
                ToolTip.Tip="Help — how to use Bunyi">
          <Path Data="{DynamicResource IconHelp}" />
        </Button>
      </StackPanel>
    </Grid>

    <!--
      Bottom bar: status, progress, and the Generate/Stop swap. Outside the
      disabled group so Stop stays pressable.
    -->
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,16,0,0">
      <!--
        A bar only where there is something to measure. A download reports a
        fraction; loading a model and generating do not — and a bar pulsing
        across the whole window says less than a spinner does, while implying a
        measurement it does not have. macOS shows a spinner for exactly these
        phases.
      -->
      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                   IsVisible="{Binding ShowProgressBar}" Height="4" />
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Classes="spinner" IsVisible="{Binding ShowSpinner}"
              Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Opacity="0.75"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="icon" Name="PlayButton" Command="{Binding PlayCommand}"
                  IsVisible="{Binding HasResult}" ToolTip.Tip="Play the result again">
            <Path Data="{DynamicResource IconPlayRound32}"
                  Fill="{Binding $parent[Button].Foreground}" Stroke="{x:Null}"
                  Stretch="None" Width="32" Height="32" />
          </Button>
          <Button Classes="icon" Name="RevealButton" Command="{Binding RevealCommand}"
                  IsVisible="{Binding HasResult}" ToolTip.Tip="Show the file on disk">
            <Path Data="{DynamicResource IconFolder}" />
          </Button>

          <!--
            §2: Generate is REPLACED by Stop, not merely disabled. A model
            download runs for minutes, and without Stop the only way out is
            closing the window.
          -->
          <Button Content="Generate" Name="GenerateButton" Command="{Binding GenerateCommand}"
                  IsEnabled="{Binding CanGenerate}" IsVisible="{Binding ShowGenerate}"
                  ToolTip.Tip="{Binding BlockedReason}"
                  IsDefault="True" MinWidth="110"
                  Background="{DynamicResource BunyiAccent}" Foreground="White" />
          <Button Content="Stop" Name="StopButton" Command="{Binding StopCommand}"
                  IsVisible="{Binding IsBusy}" IsCancel="True" MinWidth="110" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <!--
      Everything the run was started from. §2: while work is in progress the
      inputs are disabled — their values were handed to the engine when the run
      began, so leaving them editable invites changes that silently do not apply
      to the audio being produced.
    -->
    <StackPanel Spacing="16">

      <!--
        §1 opens "A segmented picker selects one of three modes"; §2a adds "A
        fourth segment beside the three generation modes". One control, four
        segments — History included, so choosing a mode leaves it the way
        choosing any segment leaves the last one.

        The mode picker is an input: switching mid-run would evict the model the
        running job is using (§2). History is not, so it stays reachable — which
        is why the segments are individually disabled rather than the control.
      -->
      <ListBox ItemsSource="{Binding AllSegments}" SelectedItem="{Binding SelectedSegment}"
               SelectionMode="Single" Height="36">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsEnabled">
              <Setter.Value>
                <MultiBinding Converter="{x:Static vm:SegmentEnabled.Instance}">
                  <Binding Path="." />
                  <Binding Path="$parent[ListBox].((vm:MainViewModel)DataContext).IsBusy" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static vm:ModeName.Instance}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Classes="card" IsVisible="{Binding ShowingHistory}" MinHeight="360">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="HISTORY" Classes="eyebrow" />
          <views:HistoryView DataContext="{Binding History}" />
        </DockPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding !ShowingHistory}"
              IsEnabled="{Binding !IsBusy}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="SCRIPT" Classes="eyebrow" />

          <!--
            The examples. They vanish once the script has anything in it and do
            not return over a generated result — an invitation to try something
            belongs to a window that has not been used yet, not beside audio the
            user just made.
          -->
          <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding ShowExamples}"
                      Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="{Binding ExamplePrompt}" FontSize="11" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding Examples}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding}" Margin="0,0,8,4" FontSize="12"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).UseExampleCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBox Text="{Binding Script}" AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="140" FontSize="15"
                   PlaceholderText="Type or paste what you would like spoken." />
        </DockPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding !ShowingHistory}"
              IsEnabled="{Binding !IsBusy}">
        <StackPanel Spacing="12">
          <TextBlock Text="OPTIONS" Classes="eyebrow" />

          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Language" Classes="rowLabel" />
            <ComboBox ItemsSource="{Binding AllLanguages}" SelectedItem="{Binding Language}"
                      MinWidth="180" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10"
                      IsVisible="{Binding ModeIsAvailable}">
            <TextBlock Text="Speaker" Classes="rowLabel" />
            <ComboBox ItemsSource="{Binding Speakers}" SelectedItem="{Binding Speaker}"
                      MinWidth="180" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="10"
                      IsVisible="{Binding ShowInstruct}">
            <TextBlock Text="{Binding InstructLabel}" Classes="rowLabel" />
            <TextBox Text="{Binding Instruct}" MinWidth="320"
                     PlaceholderText="Optional — how it should be said" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="Voice design and voice clone are not implemented yet."
                 IsVisible="{Binding !ModeIsAvailable}"
                 FontSize="12" Opacity="0.75" />
    </StackPanel>
  </DockPanel>
</Window>

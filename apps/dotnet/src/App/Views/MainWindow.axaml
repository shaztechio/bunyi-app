<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bunyi.App.ViewModels"
        xmlns:core="clr-namespace:Bunyi.Core;assembly=Bunyi.Core"
        xmlns:views="clr-namespace:Bunyi.App.Views"
        x:Class="Bunyi.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="760" Height="680" MinWidth="620" MinHeight="580"
        Title="Bunyi"
        Icon="/Assets/bunyi.png">

  <Window.Styles>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource BunyiAccent}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="{DynamicResource BunyiCardRadius}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BunyiCardBorder}" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <!--
      No fixed width. It was 76, and "Saved voice" did not fit — a number that
      works until the next label is longer, then clips it silently. The option
      rows share a size group instead, so the column is as wide as its widest
      label and every row still lines up.
    -->
    <Style Selector="TextBlock.rowLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
  </Window.Styles>

  <!-- 20 window inset, 16 between cards: the spacing scale from UI-PLAN.md. -->
  <!--
    A Grid declared top to bottom rather than a DockPanel, and the reason is
    the keyboard. Tab walks the declaration order, and a DockPanel's fill
    child has to be declared LAST - so the bottom bar came before the
    content, and Generate was the fifth thing Tab reached, straight after
    the header buttons and before the mode picker. TabIndex cannot fix it:
    it orders the whole window, not one container, and put the script box
    in front of everything. Measured in KeyboardOperationTests.
  -->
  <Grid Margin="20" RowDefinitions="Auto,*,Auto">

    <!--
      Header. §2 requires Help and the log to be one click from the main window
      and to STAY REACHABLE while work is in progress: a long download is
      exactly when someone wants to read the help or watch the log, and neither
      touches the running job. macOS gets that for free from a window toolbar;
      Avalonia has none, so they live here, outside the disabled scope by
      construction.
    -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="BUNYI" Classes="eyebrow" />
        <TextBlock Text="{Binding ModeSubtitle}" FontSize="12" Opacity="0.75" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <!--
          §11: Doctor, Logs and Help sit in one group, in that order — by how
          far the answer is from the app: whether it can run at all, what it
          did, what it is. All three are available while work is in progress; a
          run behaving strangely is exactly when they are wanted.

          Settings leads rather than splitting them. It is the odd one out —
          it changes the app rather than explaining it — and putting it between
          Doctor and Logs would be the one arrangement §11 rules out.
        -->
        <!--
          Each tooltip ends with its chord. The accessible name is set apart
          without it — a screen reader has its own property for the key, and a
          name that reads "Logs, what Bunyi has been doing, open bracket control
          L close bracket" is the kind of thing #159 exists to prevent. The
          local name outranks the tooltip-derived one in Controls.axaml.
        -->
        <Button Classes="icon" Click="OnSettingsClicked" Name="SettingsButton"
                ToolTip.Tip="Settings — models, storage and appearance (Ctrl+,)"
                AutomationProperties.Name="Settings — models, storage and appearance"
                AutomationProperties.AcceleratorKey="Ctrl+,">
          <Path Data="{DynamicResource IconSettings}" />
        </Button>
        <Button Classes="icon" Click="OnDoctorClicked" Name="DoctorButton"
                ToolTip.Tip="Doctor — can this machine generate right now? (Ctrl+D)"
                AutomationProperties.Name="Doctor — can this machine generate right now?"
                AutomationProperties.AcceleratorKey="Ctrl+D">
          <Path Data="{DynamicResource IconDoctor}" />
        </Button>
        <Button Classes="icon" Click="OnLogsClicked" Name="LogsButton"
                ToolTip.Tip="Logs — what Bunyi has been doing (Ctrl+L)"
                AutomationProperties.Name="Logs — what Bunyi has been doing"
                AutomationProperties.AcceleratorKey="Ctrl+L">
          <Path Data="{DynamicResource IconLogs}" />
        </Button>
        <Button Classes="icon" Click="OnHelpClicked" Name="HelpButton"
                ToolTip.Tip="Help — how to use Bunyi (F1)"
                AutomationProperties.Name="Help — how to use Bunyi"
                AutomationProperties.AcceleratorKey="F1">
          <Path Data="{DynamicResource IconHelp}" />
        </Button>
      </StackPanel>
    </Grid>


    <!--
      Everything the run was started from. §2: while work is in progress the
      inputs are disabled — their values were handed to the engine when the run
      began, so leaving them editable invites changes that silently do not apply
      to the audio being produced.
    -->
    <!--
      A Grid rather than a StackPanel, and that is the whole of why History
      scrolls. A StackPanel measures its children with INFINITE height in the
      stacking direction, so the ScrollViewer inside the History card was never
      given a height to fit into: it grew to whatever its rows needed and the
      overflow was simply clipped by the window. Reported from using the app —
      with enough clips, the ones at the bottom could not be reached at all.

      Spacing is on the children rather than the Grid, because a row whose only
      child is collapsed still gets its share of RowSpacing, which would leave a
      gap where the hidden card used to be.
    -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto,Auto">

      <!--
        §1 opens "A segmented picker selects one of three modes"; §2a adds "A
        fourth segment beside the three generation modes". One control, four
        segments — History included, so choosing a mode leaves it the way
        choosing any segment leaves the last one.

        The mode picker is an input: switching mid-run would evict the model the
        running job is using (§2). History is not, so it stays reachable — which
        is why the segments are individually disabled rather than the control.
      -->
      <ListBox Grid.Row="0" Name="ModePicker" ItemsSource="{Binding AllSegments}" SelectedItem="{Binding SelectedSegment}"
               SelectionMode="Single" Height="36" KeyDown="OnModePickerKeyDown">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="IsEnabled">
              <Setter.Value>
                <MultiBinding Converter="{x:Static vm:SegmentEnabled.Instance}">
                  <Binding Path="$parent[ListBox].((vm:MainViewModel)DataContext).IsBusy" />
                  <Binding Path="$parent[ListBox].((vm:MainViewModel)DataContext).ShowingHistory" />
                </MultiBinding>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static vm:ModeName.Instance}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="1" Classes="card" IsVisible="{Binding ShowingHistory}"
              Margin="0,16,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="HISTORY" Classes="eyebrow" />
          <views:HistoryView DataContext="{Binding History}" />
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Classes="card" IsVisible="{Binding !ShowingHistory}"
              IsEnabled="{Binding !IsBusy}" Margin="0,16,0,0">
        <!--
          A Grid in reading order - eyebrow, box, the missing-input line, the
          examples - for the same keyboard reason as the window's outer Grid.
          As a DockPanel the examples had to be declared before the box they
          are drawn under, and Tab reached them first.
        -->
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Grid.Row="0" Text="SCRIPT" Classes="eyebrow" />


          <TextBlock Grid.Row="2" Classes="needed" Margin="0,6,0,0"
                     Text="{Binding MissingReason}"
                     IsVisible="{Binding NeedsText}" />

          <TextBox Grid.Row="1" Name="ScriptBox" Text="{Binding Script}"
                   Classes.needed="{Binding NeedsText}"
                   AcceptsReturn="True" TextWrapping="Wrap"
                   MinHeight="140" FontSize="15"
                   PlaceholderText="Type or paste what you would like spoken." />
          <!--
            The examples. They vanish once the script has anything in it and do
            not return over a generated result — an invitation to try something
            belongs to a window that has not been used yet, not beside audio the
            user just made.
          -->
          <StackPanel Grid.Row="3" Name="Examples" IsVisible="{Binding ShowExamples}"
                      Margin="0,8,0,0" Spacing="4">
            <TextBlock Text="{Binding ExamplePrompt}" FontSize="11" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding Examples}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding}" Margin="0,0,8,4" FontSize="12"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).UseExampleCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2" Classes="card" IsVisible="{Binding !ShowingHistory}"
              IsEnabled="{Binding !IsBusy}" Margin="0,16,0,0">
        <StackPanel Spacing="12" Grid.IsSharedSizeScope="True">
          <TextBlock Text="OPTIONS" Classes="eyebrow" />

          <Grid Name="LanguageRow">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="OptionLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="LanguageLabel" Text="Language" Classes="rowLabel" />
            <!--
              LabeledBy, not a repeated Name: the label already exists on
              screen, and ControlAutomationPeer.GetNameCore falls back to it, so
              the words a reader says and the words the eye reads cannot drift.
              Without it this box announced as an unnamed combo box.

              ItemStatus is how the *change* is announced. Reported from using
              the app with Narrator: arrowing through the list changed the value
              silently. Measured, and the cause is in the toolkit —
              ComboBoxAutomationPeer raises property changes for
              IsDropDownOpen, Text and IsEditable, and none for SelectedItem, so
              a non-editable box like this one emits nothing at all when the
              selection moves. Raising Value ourselves would not help either:
              ValuePatternIdentifiers.ValueProperty is absent from the Win32
              bridge's property map, so it could not cross.

              ItemStatus is the one mapped property that fits, and it needs no
              code: ControlAutomationPeer already watches
              AutomationProperties.ItemStatusProperty and raises the peer change
              itself, and AutomationNode maps it to UIA_ItemStatusPropertyId.
              Bound through the same converter the item template uses, so what
              is announced is the words on screen rather than the raw id.
            -->
            <ComboBox Grid.Column="1" ItemsSource="{Binding AllLanguages}"
                      SelectedItem="{Binding Language}"
                      AutomationProperties.LabeledBy="{Binding #LanguageLabel}"
                      AutomationProperties.ItemStatus="{Binding Language, Converter={x:Static vm:IdentifierName.Instance}}"
                      MinWidth="180" HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding Converter={x:Static vm:IdentifierName.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid Name="SpeakerRow" IsVisible="{Binding ShowSpeakers}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="OptionLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Name="SpeakerLabel" Text="Speaker" Classes="rowLabel" />
            <!-- Named and announced the same way as Language, above. -->
            <ComboBox Grid.Column="1" ItemsSource="{Binding Speakers}"
                      SelectedItem="{Binding Speaker}"
                      AutomationProperties.LabeledBy="{Binding #SpeakerLabel}"
                      AutomationProperties.ItemStatus="{Binding Speaker, Converter={x:Static vm:IdentifierName.Instance}}"
                      MinWidth="180" HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding Converter={x:Static vm:IdentifierName.Instance}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>

          <Grid IsVisible="{Binding ShowInstruct}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="OptionLabel" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding InstructLabel}" Classes="rowLabel" />
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBox Name="InstructBox" Text="{Binding Instruct}"
                       Classes.needed="{Binding NeedsInstruction}"
                       PlaceholderText="{Binding InstructPlaceholder}" />
              <TextBlock Classes="needed" Text="{Binding MissingReason}"
                         IsVisible="{Binding NeedsInstruction}" />
            </StackPanel>
          </Grid>

          <!-- Clone mode: the recording, and what it says (spec §4, §5). -->
          <StackPanel Spacing="8" IsVisible="{Binding ShowReference}">
            <!--
              Saved voices first: picking one fills everything below, so it is
              the shortest way to a clone and belongs before the long way.
            -->
            <Grid IsVisible="{Binding HasSavedVoices}" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="OptionLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Name="SavedVoiceLabel" Text="Saved voice" Classes="rowLabel" />
              <!-- Named and announced the same way as Language, above. -->
              <ComboBox Grid.Column="1" ItemsSource="{Binding SavedVoices}"
                        SelectedItem="{Binding SelectedVoice}"
                        AutomationProperties.LabeledBy="{Binding #SavedVoiceLabel}"
                        AutomationProperties.ItemStatus="{Binding SelectedVoice.Name}"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Choose a voice you saved earlier">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:SavedVoice">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="2" Content="Delete"
                      Command="{Binding DeleteVoiceCommand}"
                      ToolTip.Tip="Remove this voice and the recording it kept" />
            </Grid>
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="OptionLabel" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Recording" Classes="rowLabel" />
              <Button Grid.Column="1" Name="ChooseRecordingButton" Content="Choose…"
                      Classes.needed="{Binding NeedsReference}"
                      Command="{Binding PickReferenceCommand}"
                      IsEnabled="{Binding CanEditTranscript}" />
              <TextBlock Grid.Column="2" Text="{Binding ReferenceName}"
                         VerticalAlignment="Center" Opacity="0.75"
                         TextTrimming="CharacterEllipsis" />
            </Grid>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="OptionLabel" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Static vm:MainViewModel.ReferenceHint}"
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                <TextBlock Classes="needed" Text="{Binding MissingReason}"
                           IsVisible="{Binding NeedsReference}" />
              </StackPanel>
            </Grid>

            <!--
              A Grid rather than a horizontal StackPanel. A StackPanel measures
              its children against infinite width, so a wrapping TextBox never
              wraps — it grows to the length of one line of transcript and runs
              off the side of the window. The star column gives it whatever is
              left over, which is what it needs to wrap inside.
            -->
            <Grid IsVisible="{Binding HasReference}" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="OptionLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="It says" Classes="rowLabel" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBox Name="TranscriptBox" Text="{Binding ReferenceTranscript}"
                         Classes.needed="{Binding NeedsTranscript}"
                         AcceptsReturn="False" TextWrapping="Wrap"
                         IsEnabled="{Binding CanEditTranscript}"
                         PlaceholderText="What the recording says, word for word" />
                <TextBlock Classes="needed" Text="{Binding MissingReason}"
                           IsVisible="{Binding NeedsTranscript}" />
              </StackPanel>
              <Button Grid.Column="2" Content="Listen again"
                      Command="{Binding ListenAgainCommand}"
                      VerticalAlignment="Top"
                      IsEnabled="{Binding CanEditTranscript}" />
            </Grid>

            <!--
              Saving needs both halves, so it lives under them. §5: a name, the
              recording and the transcript, kept together.
            -->
            <Grid IsVisible="{Binding HasReference}" ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="OptionLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Save as" Classes="rowLabel" />
              <TextBox Grid.Column="1" Text="{Binding NewVoiceName}"
                       PlaceholderText="Name this voice to use it again later" />
              <Button Grid.Column="2" Content="Save voice"
                      Command="{Binding SaveVoiceCommand}"
                      VerticalAlignment="Top" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Grid.Row="3" Text="That mode is not implemented yet."
                 IsVisible="{Binding !ModeIsAvailable}"
                 FontSize="12" Opacity="0.75" Margin="0,16,0,0" />
    </Grid>
    <!--
      Bottom bar: status, progress, and the Generate/Stop swap. Outside the
      disabled group so Stop stays pressable.
    -->
    <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
      <!--
        A bar only where there is something to measure. A download reports a
        fraction; loading a model and generating do not — and a bar pulsing
        across the whole window says less than a spinner does, while implying a
        measurement it does not have. macOS shows a spinner for exactly these
        phases.
      -->
      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                   IsVisible="{Binding ShowProgressBar}" Height="4" />
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Path Grid.Column="0" Classes="spinner" IsVisible="{Binding ShowSpinner}"
              Margin="0,0,8,0" VerticalAlignment="Center" />
        <!--
          A live region, so a screen reader announces the status as it changes
          rather than only when focus lands on it: "Generating… 49 frames · 3.9s
          of speech so far" is the one thing a person waiting on a run wants to
          hear (spec §12). Polite, not assertive — it must not talk over what
          the user is doing.

          #192 asked whether this property is anything more than a stored value,
          because a headless test can only prove it was stored. Read out of
          Avalonia 12.1.1's own source, the chain is whole on Windows and there
          is no chain at all on Linux:

            ControlAutomationPeer.GetLiveSettingCore() returns
            AutomationProperties.GetLiveSetting(Owner) — so this attribute
            reaches the peer;
            TextBlockAutomationPeer subscribes to TextBlock.TextProperty and
            raises a NameProperty change when the text changes;
            Avalonia.Win32.Automation's AutomationNode.OnPeerPropertyChanged
            then calls RaiseLiveRegionChanged() — UiaRaiseAutomationEvent with
            UIA_LiveRegionChangedEventId — for a Name change on any peer whose
            GetLiveSetting() is not Off, and serves UIA_LiveSettingPropertyId
            from GetPropertyValue. Avalonia.Win32.Automation.dll ships inside
            the Avalonia.Win32 package and is in our published artifacts.

          Avalonia.FreeDesktop.AtSpi 12.1.1 emits activation, bounds, children,
          focus, property, selection and state signals and has no live-region
          symbol anywhere in it, so Orca is told nothing here. That gap is
          recorded in spec/FEATURES.md §12 rather than left as a claim this app
          only keeps on one of its two platforms.

          tools/UiaProbe checks the Windows half where it is consumed, on a
          running window, because everything above is still only source.
        -->
        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Opacity="0.75"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Classes="icon" Name="PlayButton" Command="{Binding PlayCommand}"
                  IsVisible="{Binding HasResult}"
                  ToolTip.Tip="{Binding IsPlaying, Converter={x:Static vm:PlayTip.Instance}}">
            <Panel>
              <!--
                Play is replaced by Stop while a clip runs, as in History and
                on macOS. A button whose picture never changes gives no way to
                tell a clip that is playing from one that has finished.

                Both are drawn at final size with the centre of area already on
                the button's centre; see Icons.axaml for why Stretch cannot do
                this for a triangle.
              -->
              <Path Data="{DynamicResource IconPlayRound32}"
                    Fill="{Binding $parent[Button].Foreground}" Stroke="{x:Null}"
                    Stretch="None" Width="32" Height="32"
                    IsVisible="{Binding !IsPlaying}" />
              <Path Data="{DynamicResource IconStopRound32}"
                    Fill="{Binding $parent[Button].Foreground}" Stroke="{x:Null}"
                    Stretch="None" Width="32" Height="32"
                    IsVisible="{Binding IsPlaying}" />
            </Panel>
          </Button>

          <!--
            §2's playback progress, as on macOS: a thin bar with the elapsed
            and total time under it. Only while something is playing — a bar
            sitting at zero next to a finished clip reads as a stalled one.

            Two Borders rather than a ProgressBar. A ProgressBar animates
            between values, which is invisible while the fraction creeps
            forward and very visible at the end, where it drops the full width
            at once and reads as the bar draining backwards. The macOS app
            reached the same conclusion for the same reason.
          -->
          <StackPanel Name="PlaybackBar" Width="130" VerticalAlignment="Center" Spacing="3"
                      IsVisible="{Binding IsPlaying}">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource BunyiSurface}">
              <Border Height="4" CornerRadius="2" HorizontalAlignment="Left"
                      Background="{DynamicResource BunyiAccent}"
                      Width="{Binding PlayProgress, Converter={x:Static vm:BarWidth.Instance},
                                      ConverterParameter=130}" />
            </Border>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding ElapsedText}" FontSize="10" Opacity="0.7"
                         FontFamily="{DynamicResource BunyiMono}" />
              <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10" Opacity="0.7"
                         FontFamily="{DynamicResource BunyiMono}" />
            </Grid>
          </StackPanel>
          <Button Classes="icon" Name="RevealButton" Command="{Binding RevealCommand}"
                  IsVisible="{Binding HasResult}" ToolTip.Tip="Show the file on disk">
            <Path Data="{DynamicResource IconFolder}" />
          </Button>

          <!--
            §2: Generate is REPLACED by Stop, not merely disabled. A model
            download runs for minutes, and without Stop the only way out is
            closing the window.
          -->
          <!--
            Not disabled when the form is incomplete. A disabled button cannot
            be hovered for the tooltip that was supposed to explain it, and a
            screen reader skips it — so it was purple, unpressable and silent.
            It stays live and says what is missing when pressed.
          -->
          <Button Name="GenerateButton" Classes="primary" AutomationProperties.Name="Generate"
                  Command="{Binding GenerateCommand}"
                  IsVisible="{Binding ShowGenerate}"
                  ToolTip.Tip="{Binding BlockedReason}"
                  IsDefault="True" MinWidth="160">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{DynamicResource IconWaveform16}" Stretch="None"
                    Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock Text="Generate" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <!--
            The same width as Generate, not merely a similar one. §2 replaces
            one button with the other, and 110 was enough for "Stop" but not for
            "Generate" — so the row resized on every swap, drawing the eye to
            the layout at exactly the moment it should be on the status line.

            160 rather than 130 since the glyphs arrived: "Generate" with its
            waveform measures 152, so at 130 it sat at its natural width while
            Stop stayed on the floor, and the row jumped again. The headroom is
            so a word of copy does not silently bring the jump back.
          -->
          <Button Name="StopButton" Classes="danger" AutomationProperties.Name="Stop"
                  Command="{Binding StopCommand}"
                  IsVisible="{Binding IsBusy}" IsCancel="True" MinWidth="160"
                  ToolTip.Tip="Stop the current operation">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- Filled, so it reads as a stop sign rather than an empty box.
                   Overrides the stroke the style above gives sibling glyphs.
                   White for the same reason the style says: Foreground is set
                   on the ContentPresenter, so binding the Button's own gave
                   near-black. -->
              <Path Data="{DynamicResource IconStop16}" Stretch="None"
                    Width="16" Height="16" VerticalAlignment="Center"
                    Fill="White" Stroke="{x:Null}" />
              <TextBlock Text="Stop" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>

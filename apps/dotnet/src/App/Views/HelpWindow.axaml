<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Bunyi.App.Views.HelpWindow"
        Width="720" Height="620" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Title="Bunyi Help">

  <DockPanel>
    <!--
      A search box would be the next thing worth having; macOS gets one from
      Help Viewer's index for free and this does not. Until then the document
      is short enough to scroll, and the headings carry the structure.
    -->
    <ScrollViewer Name="Scroller" Padding="28,24">
      <StackPanel Name="Body" MaxWidth="620" HorizontalAlignment="Left" />
    </ScrollViewer>
  </DockPanel>
</Window>

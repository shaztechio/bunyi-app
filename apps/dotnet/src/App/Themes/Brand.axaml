<!--
  The brand colours, in their own dictionary so the app and the headless tests
  load exactly the same ones. §7 makes three appearance states a requirement,
  so a colour that only works against one background is a bug in the other two —
  which is why each is defined per theme rather than once.

  The two indigos are the same sRGB values the macOS accent colorset and the
  website use. Three copies of a brand colour is already one too many; this
  comment is what stops it becoming four.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://Bunyi.App/Themes/Icons.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    The radius scale. UI-PLAN.md gives 12 for cards, 8 for the controls inside
    them and a capsule for pills; these are those, named so a value is never
    typed twice and the shapes stay related to each other.
  -->
  <CornerRadius x:Key="BunyiCardRadius">12</CornerRadius>
  <CornerRadius x:Key="BunyiControlRadius">8</CornerRadius>
  <CornerRadius x:Key="BunyiPillRadius">999</CornerRadius>
  <sys:Double x:Key="BunyiIconButtonSize">32</sys:Double>

  <!--
    The monospaced face, for the Logs window and for code in Help.

    A stack rather than one name, because no single monospaced font ships on
    both Windows and Linux: Consolas is Windows', DejaVu Sans Mono is on
    essentially every desktop Linux, and "monospace" is the last resort the
    font manager resolves itself. §8 asks for monospaced by name — timestamps
    are read down a column, and proportional digits make that harder than it
    needs to be.
  -->
  <FontFamily x:Key="BunyiMono">Consolas, DejaVu Sans Mono, Menlo, monospace</FontFamily>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="BunyiAccent" Color="#5C54F5" />
      <SolidColorBrush x:Key="BunyiCardBorder" Color="#22000000" />
      <!-- A recessed panel: the log reads as something the window contains. -->
      <SolidColorBrush x:Key="BunyiSurface" Color="#08000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BunyiAccent" Color="#7B72F0" />
      <SolidColorBrush x:Key="BunyiCardBorder" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="BunyiSurface" Color="#14FFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

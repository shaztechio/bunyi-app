<!--
  The shared control language, at APPLICATION level rather than per window.

  It was per window, which meant the confirmation dialogs missed it entirely:
  those are separate Window objects created in code, and a window's styles do
  not reach them. So Trash asked its question through square buttons while
  everything behind it was rounded. Anything defined here reaches every window
  the app opens, including ones built at runtime.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Rounding, from the scale in Brand.axaml. -->
  <!--
    Centred content on every button.

    Avalonia's Fluent theme leaves HorizontalContentAlignment at Stretch, so a
    button's label fills the whole width and the text inside it sits at the
    left. On a button whose word nearly fills it that is invisible; on a short
    word in a wide button it is plainly wrong, which is how "Stop" ended up
    against the left edge of a 110-wide button while "Generate" beside it
    looked fine.
  -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="{DynamicResource BunyiControlRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton">
    <Setter Property="CornerRadius" Value="{DynamicResource BunyiControlRadius}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="{DynamicResource BunyiControlRadius}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{DynamicResource BunyiControlRadius}" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="CornerRadius" Value="{DynamicResource BunyiControlRadius}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource BunyiControlRadius}" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="{DynamicResource BunyiPillRadius}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="CornerRadius" Value="{DynamicResource BunyiControlRadius}" />
  </Style>

  <!-- Icon buttons: circular, with the glyph comfortably inside. -->
  <!--
    The two action buttons, Generate and Stop.

    Their colour has to be restated for every visual state, which is not
    decoration: Fluent styles the button's inner presenter directly on hover and
    press, and that beats a Background set on the Button itself. So a brand
    button set the plain way looks right until the pointer touches it and then
    turns grey — which Generate did.

    macOS keeps the same fill throughout and only dims on press
    (Theme.swift, ActionButtonStyle), so these do the same rather than inventing
    hover shades the other app does not have.
  -->
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BunyiAccent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BunyiAccent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BunyiAccent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!--
    A field the run is waiting on. Only ever set after Generate was pressed and
    could not run — never before, because marking fields nobody has reached yet
    is telling someone off for not having finished.

    Colour is not the only signal: the field is focused and a sentence appears
    beside it, so this works for anyone who cannot see the red.
  -->
  <Style Selector="TextBox.needed">
    <Setter Property="BorderBrush" Value="{DynamicResource BunyiDanger}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.needed">
    <Setter Property="BorderBrush" Value="{DynamicResource BunyiDanger}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBlock.needed">
    <Setter Property="Foreground" Value="{DynamicResource BunyiDanger}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!--
    A primary button that cannot be used should not look like one. The style set
    the accent background in every state, so a disabled Generate stayed purple
    and looked pressable — which is half of why "Generate does nothing" was the
    reported symptom.
  -->
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!--
    A link: text that happens to be clickable, not a button wearing a URL.
    Avalonia has no HyperlinkButton in this version, so it is a Button stripped
    back to its content, underlined on hover the way a link is anywhere else.
  -->
  <Style Selector="Button.link">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource BunyiAccent}" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextBlock.TextDecorations" Value="Underline" />
  </Style>
  <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>

  <!--
    Stop is red, as on macOS, and never a disabled grey — it only exists while
    there is something to stop, so it is always live and always the way out.
  -->
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BunyiDanger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BunyiDanger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BunyiDanger}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- Both carry the weight macOS gives them. -->
  <Style Selector="Button.primary, Button.danger">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="{DynamicResource BunyiIconButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource BunyiIconButtonSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource BunyiPillRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!--
    A DESCENDANT selector, not a direct-child one. It was "Button.icon > Path",
    which silently missed any icon wrapped in a Panel — so the Copy button,
    which holds two Paths so it can swap to a tick, drew nothing at all. An
    unstyled Path has no stroke, so the button looked empty rather than wrong.
  -->
  <Style Selector="Button.icon Path">
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <!--
      15 inside 32 leaves a clear ring of space. At 18 the widest glyph — the
      log lines, which span the full grid — touched the edge of the circle,
      because Stretch=Uniform scales each icon's own bounding box to fill
      whatever box it is given.
    -->
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    The spinner: a three-quarter arc that turns.

    macOS shows one while generating, and an indeterminate bar is a poor
    substitute — it fills the width of the window for something that is not a
    measurement. A rotating arc says "working" without implying progress it
    cannot report.
  -->
  <Style Selector="Path.spinner">
    <Setter Property="Stroke" Value="{DynamicResource BunyiAccent}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Data" Value="M8,1 A7,7 0 1 1 1,8" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>

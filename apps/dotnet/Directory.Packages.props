<Project>

  <!--
    Every version in one file. The scaffold previously carried versions in each
    csproj under a comment saying they were indicative and unverified; these are
    the ones actually resolved and, where it mattered, measured. See
    RESEARCH-ONNX.md before changing any of them.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- No Avalonia.Diagnostics: it stops at 11.3.20, the DevTools having
         moved into the core packages in 12. -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Inference">
    <!--
      NOT pinned to 1.24.4. That ceiling belonged to the DirectML package,
      which is dropped: on an RTX 4090 DirectML lost to plain CPU and crashed
      the vocoder. See RESEARCH-ONNX.md.
    -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.29.0" />
    <PackageVersion Include="ElBruno.QwenTTS" Version="1.7.2" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup Label="Audio and transcription">
    <PackageVersion Include="SoundFlow" Version="1.4.1" />
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />
  </ItemGroup>

</Project>
